{
  "name": "kopeechka-bot",
  "version": "0.0.8",
  "description": "Personal finance Telegram bot with budgets, recurring payments, savings goals, analytics and CSV export",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.json\" \"*.mjs\"",
    "lint": "eslint .",
    "check": "npm run format:check && npm run lint && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.0",
    "prettier": "^3.4.2",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "globals": "^15.14.0",
    "@eslint/js": "^9.17.0"
  }
}
