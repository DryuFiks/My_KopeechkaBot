# Telegram bot token from @BotFather
BOT_TOKEN=

# PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# If Postgres runs in a local Docker container, HOST is usually "localhost"
# and PORT is whatever port you mapped with -p (check with: docker port <container_id>)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/finance_bot

# Telegram numeric user ID allowed to restart the bot (get it from @userinfobot)
ADMIN_TELEGRAM_ID=
