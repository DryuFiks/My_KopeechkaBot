[Unit]
Description=Daily Kopeechka DB backup (MKB-044)

[Timer]
# 05:30 по Тбилиси — ночью, когда ботом никто не пользуется. Persistent: пропущенный запуск
# (машина была выключена) выполнится сразу после загрузки.
OnCalendar=*-*-* 01:30:00 UTC
Persistent=true
RandomizedDelaySec=10m

[Install]
WantedBy=timers.target
